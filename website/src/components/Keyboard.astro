---
const rows = [['Esc','q','w','e','r','t','y','u','i','o','p','⌫'],['Tab','a','s','d','f','g','h','j','k','l','Enter'],['Shift','z','x','c','v','b','n','m',',','.','Shift']];
---
<div class="keyboard" aria-label="Illustrated Mousyst keyboard"><div class="keyboard-title"><span>mousyst</span><span class="keyboard-dots">−　×</span></div><div class="suggestions"><span>would</span><span class="chosen">world</span><span>word</span><span>↶</span></div>{rows.map((row,i)=><div class:list={['key-row',`row-${i}`]}>{row.map((key,j)=><div class:list={['key',key.length>1&&'wide']} data-key={key}><small>{i===0&&j>0&&j<11?j%10:''}</small><span>{key}</span></div>)}</div>)}<div class="key-row bottom"><div class="key">123</div><div class="key">Ctrl</div><div class="key">⊞</div><div class="key">Alt</div><div class="key space"><span></span></div><div class="key">←</div><div class="key">→</div></div><svg class="trail" aria-hidden="true"><g class="trail-segments"></g><g class="swipe-pointer"><circle class="pointer-halo" r="17"/><path class="wheel-mark" d="M-10 -12 L-10 -28 M-14 -24 L-10 -28 L-6 -24"/><path class="pointer-arrow" d="M0 0 L3 20 L8 14 L14 23 L19 20 L13 11 L21 10 Z"/></g></svg></div>
<style>.keyboard{position:relative;width:100%;padding:14px;background:#1c201e;border:1px solid #454e47;border-radius:15px;box-shadow:0 35px 75px #0008,inset 0 1px #6b756944;font-family:'DM Sans',sans-serif}.keyboard-title{display:flex;justify-content:space-between;padding:0 7px 12px;font-size:11px;color:#a5afa7}.keyboard-dots{color:#657168}.suggestions{display:flex;justify-content:space-around;align-items:center;height:38px;margin-bottom:10px;font-size:13px;color:#85958b}.suggestions .chosen{color:#c3f0d3}.key-row{display:flex;gap:5px;margin-bottom:5px}.key{position:relative;flex:1;height:48px;border:1px solid #434b45;border-bottom:2px solid #111713;border-radius:5px;background:linear-gradient(#303732,#292f2c);display:flex;align-items:center;justify-content:center;color:#e5eae6;font-size:16px;box-shadow:0 1px 2px #0005}.key small{position:absolute;top:4px;left:6px;font-size:8px;color:#88958b}.key.wide{flex:1.4;font-size:11px}.row-1{padding-left:17px}.row-2{padding-left:8px}.bottom{margin:0}.bottom .key{height:42px;font-size:10px}.key.space{flex:5}.space span{width:32px;height:2px;background:#66746b;align-self:flex-end;margin-bottom:7px}.trail{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}.trail-segments{fill:none;stroke:var(--mint);stroke-width:4;stroke-linecap:round;stroke-linejoin:round}.pointer-halo{fill:var(--mint);opacity:.12}.pointer-arrow{fill:#edf9f0;stroke:#1b3827;stroke-width:1.5;stroke-linejoin:round}.swipe-pointer{opacity:0}.wheel-mark{opacity:0;fill:none;stroke:var(--mint);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.wheel-active .wheel-mark{opacity:1}.key.is-hit{background:#466353;border-color:var(--mint);color:white;box-shadow:0 0 18px #b7efcc22}.suggestions{visibility:hidden}.keyboard.has-result .suggestions{visibility:visible}.keyboard.is-corrected .suggestions .chosen{color:#89958b}.keyboard.is-corrected .suggestions span:nth-child(3){color:var(--mint)}@media(max-width:700px){.keyboard{padding:9px;border-radius:10px}.key{height:33px;font-size:12px}.key.wide{font-size:8px}.bottom .key{height:30px}.key-row{gap:3px;margin-bottom:3px}.suggestions{height:24px;font-size:10px}.keyboard-title{font-size:9px}.key small{display:none}}</style>
