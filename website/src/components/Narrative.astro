---
const { kind } = Astro.props;
---
{kind === 'problem' && <section class="narrative problem-chapter" id="problem"><div class="chapter-pin"><div class="chapter-label eyebrow" data-en="01 / THE LITTLE INTERRUPTION" data-zh="01 / 小小的中斷">01 / THE LITTLE INTERRUPTION</div><div class="problem-statement"><h2 data-en="Just one quick thing." data-zh="只是想，做一件小事。">Just one quick thing.</h2><p data-en="And your hand is already reaching." data-zh="你的手，卻又離開了滑鼠。">And your hand is already reaching.</p></div><div class="interruption-cards">{[
['01','A quick reply.','回一句訊息。','Leave the mouse. Find the keys. Pick up the thought again.','離開滑鼠，找到鍵盤，再接回剛剛的思緒。','reply'],
['02','One little search.','搜尋一個問題。','A few words, another trip across the desk.','只是幾個字，又在桌面上來回一次。','search'],
['03','A familiar shortcut.','一組熟悉的快捷鍵。','Copy. Paste. Reach. Repeat.','複製、貼上，伸手，再來一次。','shortcut']
].map(([n,en,zh,body,bodyzh,icon])=><article class="interruption-card"><span>{n}</span><h3 data-en={en} data-zh={zh}>{en}</h3><svg viewBox="0 0 300 150" fill="none" aria-hidden="true">{icon==='reply'?<><rect x="40" y="20" width="220" height="90" rx="12"/><path d="M65 110v25l35-25M75 50h145M75 75h90"/></>:icon==='search'?<><rect x="25" y="40" width="250" height="65" rx="32"/><circle cx="65" cy="70" r="12"/><path d="m74 80 13 13M115 72h115"/></>:<><rect x="40" y="30" width="85" height="85" rx="8"/><rect x="175" y="30" width="85" height="85" rx="8"/><path d="M140 72h20M150 62v20"/><text x="60" y="82" fill="currentColor" stroke="none" font-size="23">Ctrl</text><text x="204" y="82" fill="currentColor" stroke="none" font-size="25">C</text></>}</svg><p data-en={body} data-zh={bodyzh}>{body}</p></article>)}</div></div></section>}
{kind === 'solution' && <section class="narrative solution-chapter" id="idea"><div class="chapter-pin"><div class="chapter-label eyebrow" data-en="02 / A DIFFERENT APPROACH" data-zh="02 / 換一種方式">02 / A DIFFERENT APPROACH</div><h2 class="manifesto"><span data-en="BRING THE" data-zh="讓鍵盤">BRING THE</span><span class="outline-type" data-en="KEYBOARD" data-zh="來到">KEYBOARD</span><span data-en="TO YOUR" data-zh="你的">TO YOUR</span><span class="mint" data-en="MOUSE." data-zh="滑鼠旁。">MOUSE.</span></h2><p class="manifesto-note" data-en="A familiar layout. A different way through it." data-zh="熟悉的排列，不一樣的輸入方式。">A familiar layout. A different way through it.</p></div></section>}
<style>
.narrative{position:relative;background:#0c0e0d}.chapter-pin{height:100svh;min-height:650px;position:sticky;top:0;overflow:hidden;isolation:isolate}.chapter-label{position:absolute;top:42px;left:10vw;font-size:9px}.problem-chapter{height:320vh}.problem-statement{position:absolute;top:17%;width:100%;text-align:center;padding:0 12vw;will-change:transform,opacity}.problem-statement h2{font-size:clamp(40px,5.5vw,95px);margin:12px 0;letter-spacing:-.06em}.problem-statement>p{font-size:clamp(28px,4.3vw,72px);font-family:'Space Grotesk','Noto Sans TC',sans-serif;line-height:1.13;letter-spacing:-.04em;color:var(--mint);max-width:850px;margin:15px auto}.interruption-cards{display:flex;position:absolute;top:55%;left:18%;gap:3vw;width:max-content;will-change:transform}.interruption-card{background:#1b201d;border:1px solid #354139;width:31vw;max-width:500px;min-width:290px;padding:28px;will-change:transform;box-shadow:0 30px 70px #0004}.interruption-card>span{font-size:10px;color:var(--muted)}.interruption-card h3{font-size:clamp(24px,2.3vw,39px);margin:24px 0 0;letter-spacing:-1px}.interruption-card svg{width:100%;height:140px;margin:15px 0;stroke:var(--mint);stroke-width:1.2;color:var(--mint)}.interruption-card p{font-size:12px;color:var(--muted);max-width:270px}.solution-chapter{height:220vh}.solution-chapter .chapter-pin{display:grid;place-content:center;text-align:center}.manifesto{font-size:clamp(55px,9vw,155px);line-height:.95;letter-spacing:-.065em;margin:0;will-change:transform}.manifesto span{display:block;will-change:opacity,transform}.outline-type{color:transparent;-webkit-text-stroke:1px var(--fg)}.manifesto-note{font-size:11px;color:var(--muted);margin-top:40px;letter-spacing:1px}@media(max-width:800px){.chapter-pin{min-height:650px}.chapter-label{left:6vw;top:30px;font-size:8px}.problem-chapter{height:280vh}.problem-statement{top:18%;padding:0 7vw}.problem-statement h2{font-size:39px}.problem-statement>p{font-size:31px}.interruption-cards{top:50%;left:8%;gap:20px}.interruption-card{width:76vw;min-width:0;padding:20px}.interruption-card svg{height:120px}.interruption-card h3{font-size:26px}.solution-chapter{height:190vh}.manifesto{font-size:13vw}.manifesto-note{font-size:10px;padding:0 25px}}@media(prefers-reduced-motion:reduce){.narrative{height:auto}.chapter-pin{height:auto;min-height:0;padding:90px 6vw}.chapter-label{position:static}.problem-statement{position:static;padding:40px 0}.interruption-cards{position:static;display:grid;width:auto;transform:none!important}.interruption-card{width:100%;max-width:none;transform:none!important}.manifesto{margin-top:45px;transform:none!important}.manifesto span{opacity:1!important;transform:none!important}}
</style>
