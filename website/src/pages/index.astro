---
import Shell from '../layouts/Shell.astro';
import Keyboard from '../components/Keyboard.astro';
import Narrative from '../components/Narrative.astro';
---
<Shell><nav class="chapter-nav" aria-label="Story chapters">{[['intro','INTRO','序章'],['problem','THE INTERRUPTION','小小中斷'],['idea','THE IDEA','另一種方式'],['how','THE EXPERIENCE','使用體驗'],['possibilities','POSSIBILITIES','更多可能'],['download','GET MOUSYST','開始使用']].map(([id,en,zh])=><a href={`#${id}`} data-en={en} data-zh={zh}>{en}</a>)}</nav><div class="intro-scroll" id="intro"><section class="hero"><div class="hero-top"><div class="eyebrow" data-en="A different kind of keyboard" data-zh="探索另一種鍵盤">A different kind of keyboard</div><span class="edition">01 / INTRODUCING MOUSYST</span></div><h1><span data-en="Your mouse." data-zh="你的滑鼠，">Your mouse.</span><br/><span class="mint" data-en="Your keyboard." data-zh="也是你的鍵盤。">Your keyboard.</span></h1><div class="hero-bottom"><p data-en="A thought, a click, a glide. Type words and use shortcuts without taking your hand off the mouse." data-zh="一個想法，一次點擊，一道滑行。用滑鼠輸入文字、操作快捷鍵，讓靈感接著走。">A thought, a click, a glide. Type words and use shortcuts without taking your hand off the mouse.</p><div class="actions"><a class="button" href="https://github.com/HarvyLiu/Mousyst/releases/latest"><span data-en="Download for Windows" data-zh="下載 Windows 版">Download for Windows</span> ↗</a><a class="text-link" href="#how" data-en="Explore the experience ↓" data-zh="探索使用體驗 ↓">Explore the experience ↓</a></div></div><div class="product"><div class="intro-montage" aria-hidden="true">{[['REPLY / 回覆','See you soon.','↵'],['SEARCH / 搜尋','A little curiosity.','⌕'],['SHORTCUT / 快捷鍵','Ctrl + V','↗'],['CREATE / 建立','One more idea.','+']].map(([label,body,icon])=><div class="montage-panel"><span>{label}</span><strong>{body}</strong><i>{icon}</i></div>)}</div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="product-label">OFFLINE. ON YOUR DESKTOP.</div><div class="hero-keyboard"><Keyboard/></div><div class="product-note"><span class="status"></span><span data-en="English swipe typing · Windows x64" data-zh="英文滑行輸入 · Windows x64">English swipe typing · Windows x64</span></div></div><div class="section-line"><span data-en="LESS REACHING. MORE FLOW." data-zh="少一點伸手，多一點流暢。">LESS REACHING. MORE FLOW.</span><span>SCROLL TO DISCOVER ↓</span></div></section></div>
<Narrative kind="problem"/><Narrative kind="solution"/>
<section id="how" class="scroll-story" aria-label="Scroll through the Mousyst experience">
<div class="story-stage">
  <div class="scene-backdrop" aria-hidden="true">FLOW</div>
  <div class="story-topline"><span class="eyebrow" data-en="03 — The experience" data-zh="03 — 使用體驗">03 — The experience</span><span class="scene-counter">01 / 04</span></div>
  <div class="scene-copy">
  {[
    ['One press.','Right here.','按一下，','就在這裡。','Middle-click. Your keyboard comes to you.','按下中鍵，讓鍵盤來到你身邊。'],
    ['Less reaching.','More gliding.','少一點伸手，','多一點滑行。','Hold and trace W → O → R → L → D. Follow the pointer as you scroll.','按住並依序滑過 W → O → R → L → D。隨著捲動，跟上游標的軌跡。'],
    ['Lift a finger.','Leave a word.','手指放開，','留下單字。','Release to recognize the word, entirely offline. A space follows automatically.','放開後，在本機辨識單字，並自動補上空白。'],
    ['A second thought?','One small scroll.','想換個字？','輕輕滾動。','Hover over suggestions and scroll to replace the latest word.','在候選字列上滾動，替換上一個單字。']
  ].map(([first,last,zhfirst,zhlast,en,zh],i)=><article class="scene" data-scene={i}><h2><span data-en={first} data-zh={zhfirst}>{first}</span><br/><span class="mint" data-en={last} data-zh={zhlast}>{last}</span></h2><p data-en={en} data-zh={zh}>{en}</p></article>)}
  </div>
  <div class="scene-object"><div class="demo-output"><span class="muted">MESSAGE / 訊息</span><p><span id="demo-word"></span><span class="caret">|</span></p></div><Keyboard/></div>
  <div class="story-bottom"><span class="demo-caption" data-en="Scroll to play · scroll back to rewind · desktop illustration" data-zh="向下播放 · 向上倒轉 · 桌面操作示意">Scroll to play · scroll back to rewind · desktop illustration</span><div class="story-track"><span></span></div></div>
</div>
</section>
<section class="features" id="possibilities"><div class="features-pin"><div class="eyebrow">04 — BEYOND LETTERS</div><h2 class="reveal" data-en="Small moves. More possibilities." data-zh="小小動作，更多可能。">Small moves.<br/>More possibilities.</h2><div class="feature-grid">{[
['Ctrl + C','Shortcuts, within reach.','快捷操作，觸手可及。','Select a modifier, then a key. Copy, paste, and use familiar Windows shortcuts.','選擇修飾鍵，再按下一個鍵。複製、貼上，以及熟悉的 Windows 快捷鍵。'],
['1 2 3 +','Numbers have a place.','數字，也有自己的位置。','Switch to symbols or a numpad in the same space. Right-click letters for their secondary symbols.','在相同空間中切換符號或數字鍵盤，也能右鍵點擊字母，輸入對應符號。'],
['← ━━━ →','Find just the right spot.','找到剛剛好的位置。','Hold Space and drag horizontally to move the caret. Tap it for an ordinary space.','按住空白鍵並左右拖曳，就能移動文字游標。輕點則輸入空白。']
].map(([visual,en,zh,body,bodyzh])=><article class="feature reveal"><div class="feature-visual">{visual}</div><h3 data-en={en} data-zh={zh}>{en}</h3><p data-en={body} data-zh={bodyzh}>{body}</p></article>)}</div></div></section>
<section class="customize reveal"><div><div class="eyebrow">05 — YOUR SPACE</div><h2 data-en="Make yourself at home." data-zh="調成，你喜歡的樣子。">Make yourself<br/>at home.</h2><p class="muted" data-en="The desktop app offers layouts, sizes, and colors. Pick an accent here for a little preview." data-zh="桌面版支援版型、大小與配色調整。先在這裡挑選喜歡的主題色，感受一下。">The desktop app offers layouts, sizes, and colors. Pick an accent here for a little preview.</p><div class="swatches" aria-label="Preview accent color"><button class="active" data-color="#b7efcc" style="--swatch:#b7efcc" aria-label="Mint" aria-pressed="true"></button><button data-color="#c8bded" style="--swatch:#c8bded" aria-label="Lavender" aria-pressed="false"></button><button data-color="#edc7a4" style="--swatch:#edc7a4" aria-label="Peach" aria-pressed="false"></button><button data-color="#b5d8ef" style="--swatch:#b5d8ef" aria-label="Blue" aria-pressed="false"></button></div></div><div class="custom-card"><span class="eyebrow">MOUSYST / PERSONAL</span><div class="sample-key">M</div><p data-en="A keyboard that feels like yours." data-zh="屬於你的鍵盤風格。">A keyboard that feels like yours.</p><a href="/docs/settings/" class="text-link" data-en="Explore settings ↗" data-zh="探索設定 ↗">Explore settings ↗</a></div></section>
<section class="closing" id="download"><div class="pixel-field" aria-hidden="true">{Array.from({length:72},(_,i)=><span style={`--i:${i};--h:${15+(i*37)%80}%;--x:${(i*17)%100}%`}></span>)}</div><div class="eyebrow">06 — GIVE IT A GLIDE</div><h2 data-en="Meet your mouse’s other half." data-zh="認識滑鼠的另一半。">Meet your mouse’s<br/>other half.</h2><p class="muted" data-en="A portable Windows preview. Download, extract, and open. No Python installation needed." data-zh="免安裝的 Windows 預覽版。下載、解壓縮、開啟，不需要安裝 Python。">A portable Windows preview. Download, extract, and open. No Python installation needed.</p><div class="actions"><a class="button" href="https://github.com/HarvyLiu/Mousyst/releases/latest"><span data-en="Download Mousyst" data-zh="下載 Mousyst">Download Mousyst</span> ↗</a><a class="button secondary" href="/docs/" data-en="Getting started →" data-zh="開始使用 →">Getting started →</a></div><p class="fine" data-en="Windows x64 · English recognition · Desktop preview" data-zh="Windows x64 · 英文辨識 · 桌面預覽版">Windows x64 · English recognition · Desktop preview</p></section></Shell>
<script>import "../scripts/scroll-story"; import "../scripts/chapters"; document.querySelectorAll<HTMLButtonElement>('[data-color]').forEach(button=>button.addEventListener('click',()=>{document.documentElement.style.setProperty('--mint',button.dataset.color!);document.querySelectorAll('[data-color]').forEach(b=>{b.classList.remove('active');b.setAttribute('aria-pressed','false')});button.classList.add('active');button.setAttribute('aria-pressed','true')}));</script>
<style>.hero{padding:42px 8vw 0}.hero-top,.section-line{display:flex;justify-content:space-between;align-items:center}.edition,.section-line,.product-label{font-size:9px;letter-spacing:1.6px;color:var(--muted)}h1{font-size:clamp(65px,9.2vw,150px);margin:45px 0 28px}.mint{color:var(--mint)}.hero-bottom{display:flex;justify-content:space-between;align-items:center;gap:40px}.hero-bottom p{max-width:370px;font-size:14px;color:var(--muted)}.actions{display:flex;gap:22px;align-items:center}.text-link{font-size:12px;border-bottom:1px solid #515f55;padding-bottom:5px}.product{position:relative;min-height:410px;display:flex;align-items:center;justify-content:center;perspective:1200px;margin-top:25px;overflow:hidden}.hero-keyboard{width:650px;transform:rotateX(24deg) rotateZ(-7deg);animation:float 8s ease-in-out infinite;z-index:1}.orbit{position:absolute;border:1px solid #34423977;border-radius:50%;width:850px;height:280px;transform:rotate(-12deg)}.orbit-two{width:1060px;height:370px}.product-label{position:absolute;top:45px;right:0;font-size:8px}.product-note{position:absolute;bottom:10px;display:flex;align-items:center;gap:8px;color:var(--muted);font-size:10px}.status{width:5px;height:5px;border-radius:50%;background:var(--mint)}.section-line{border-top:1px solid var(--line);padding:20px 0}.experience,.features,.customize,.closing{padding:110px 8vw}.story-heading p{max-width:460px}.story-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:9%;align-items:start;margin-top:70px}.sticky-demo{position:sticky;top:90px}.demo-output{background:#171c19;border:1px solid var(--line);border-radius:10px;margin-bottom:25px;padding:22px}.demo-output>span{font-size:9px;letter-spacing:2px}.demo-output p{font-size:30px;margin:10px 0}.caret{color:var(--mint);animation:blink 1s steps(2) infinite}.demo-caption{display:block;text-align:center;font-size:10px;color:var(--muted);margin-top:20px}.step{padding:22px 0 55px;border-top:1px solid var(--line)}.step-number{font-size:10px;color:var(--mint)}.step h3{font-size:30px;letter-spacing:-1px;line-height:1.2}.step p{font-size:14px}.features{background:#171c19;border-block:1px solid var(--line)}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-top:55px}.feature-visual{height:130px;display:flex;align-items:center;color:var(--mint);font-size:28px;font-family:'Space Grotesk',sans-serif;letter-spacing:5px;border-bottom:1px solid #39423c}.feature h3{font-size:23px}.feature p{font-size:13px;color:var(--muted)}.customize{display:grid;grid-template-columns:1fr 1fr;gap:12%;align-items:center}.customize p{font-size:14px;max-width:390px}.swatches{display:flex;gap:13px;margin-top:25px}.swatches button{width:28px;height:28px;background:var(--swatch);border:5px solid var(--bg);border-radius:50%;outline:1px solid transparent}.swatches button.active{outline-color:var(--swatch)}.custom-card{border:1px solid var(--line);border-radius:12px;background:radial-gradient(ellipse at center,#2d3d32,#171c19 70%);padding:30px}.sample-key{width:130px;height:130px;border:1px solid var(--mint);border-bottom-width:5px;border-radius:20px;display:grid;place-items:center;font-size:75px;color:var(--mint);font-family:Georgia,serif;font-style:italic;transform:rotate(-8deg);margin:40px auto}.custom-card p{text-align:center;margin:35px 0}.closing{border-top:1px solid var(--line);text-align:center}.closing .eyebrow,.closing .actions{justify-content:center}.closing h2{font-size:clamp(45px,6.5vw,100px)}.closing p{max-width:450px;margin:25px auto}.fine{font-size:10px!important;letter-spacing:1px;color:var(--muted)}@keyframes float{50%{transform:rotateX(20deg) rotateZ(-5deg) translateY(-10px)}}@keyframes blink{50%{opacity:0}}@media(max-width:800px){.hero{padding:30px 6vw 0}.edition{display:none}.hero-bottom{display:block}.hero-bottom .actions{margin-top:25px;flex-wrap:wrap}.product{min-height:320px}.hero-keyboard{width:95%}.product-label{display:none}.section-line{font-size:7px}.experience,.features,.customize,.closing{padding:75px 6vw}.story-grid,.customize{grid-template-columns:1fr;gap:45px}.sticky-demo{position:relative;top:0}.feature-grid{grid-template-columns:1fr;gap:20px}.feature-visual{height:90px}.closing .actions{flex-wrap:wrap}.story-grid{margin-top:40px}}
</style>

<style>
.hero-keyboard{animation:none;will-change:transform}.hero h1{will-change:transform}.scroll-story{height:520vh;position:relative;border-top:1px solid var(--line)}.story-stage{height:100svh;min-height:620px;position:sticky;top:0;overflow:hidden;background:radial-gradient(ellipse at 65% 60%,#23392a77,transparent 65%),#0d100e;padding:38px 5vw;isolation:isolate}.scene-backdrop{position:absolute;top:14%;left:5%;font:600 clamp(200px,33vw,600px)/1 'Space Grotesk',sans-serif;letter-spacing:-.08em;opacity:.04;pointer-events:none;z-index:-1;color:var(--mint);will-change:transform}.story-topline{display:flex;align-items:center;justify-content:space-between}.scene-counter{font-size:11px;letter-spacing:2px;color:var(--muted)}.scene-copy{position:absolute;left:6vw;top:30%;width:39%;height:45%}.scene{position:absolute;inset:0;opacity:0;visibility:hidden;will-change:transform,opacity}.scene:first-child{opacity:1;visibility:visible}.scene h2{font-size:clamp(38px,4.5vw,78px);line-height:1.04;letter-spacing:-.06em}.scene p{font-size:13px;color:var(--muted);max-width:340px;margin-top:30px}.scene-object{position:absolute;top:32%;right:5vw;width:48%;max-width:850px;transform-origin:center;will-change:transform,opacity}.scene-object .demo-output{margin-bottom:24px;background:#151d18bb;backdrop-filter:blur(12px);height:110px}.story-bottom{position:absolute;bottom:30px;left:5vw;right:5vw;display:flex;align-items:center;justify-content:space-between;gap:30px}.story-bottom .demo-caption{margin:0;font-size:10px;text-align:left}.story-track{height:2px;background:#354038;width:180px;overflow:hidden}.story-track span{display:block;background:var(--mint);height:100%;transform-origin:left;transform:scaleX(0)}.feature{will-change:transform;transition:opacity .8s}.features{overflow:hidden}.features h2{max-width:900px}.scene-object .caret{animation:none}
@media(min-width:1600px){.scene-object{top:30%}}
@media(max-width:800px){.scroll-story{height:440vh}.story-stage{min-height:700px;padding:28px 6vw}.scene-copy{top:13%;width:88%;left:6vw;height:25%}.scene h2{font-size:clamp(32px,7.4vw,48px);margin:15px 0}.scene p{font-size:12px;margin-top:15px;max-width:90%}.scene-object{top:48%;width:88%;right:6vw;max-width:none}.scene-object .demo-output{height:75px;padding:12px;margin-bottom:14px}.scene-object .demo-output p{font-size:23px;margin:3px 0}.story-bottom{bottom:22px}.story-track{width:70px;flex-shrink:0}.story-bottom .demo-caption{font-size:8px}.scene-backdrop{top:39%;font-size:45vw}}
@media(prefers-reduced-motion:reduce){.scroll-story{height:auto}.story-stage{position:relative;height:auto;min-height:750px}.scene-copy{top:110px}.scene-object{top:330px}.scene-backdrop{display:none}.story-track{display:none}.hero h1,.hero-keyboard{transform:none!important}}
</style>

<style>
.chapter-nav{position:fixed;top:43%;left:20px;z-index:25;display:flex;flex-direction:column;align-items:flex-start;gap:13px;font:8px 'DM Sans',sans-serif;letter-spacing:1px}.chapter-nav a{color:#6e7a71;position:relative;padding-left:12px}.chapter-nav a.active{color:var(--fg)}.chapter-nav a.active:before{content:'';width:4px;height:4px;background:var(--mint);position:absolute;left:0;top:3px}.intro-scroll{height:240vh}.hero{position:sticky;top:0;height:100svh;min-height:720px;overflow:hidden;padding-top:30px;background:#101211;perspective:1400px}.hero h1{font-size:clamp(60px,8.5vw,145px);margin:35px 0 20px;transform-origin:center;position:relative;z-index:1}.hero-top,.hero-bottom,.section-line{will-change:opacity}.hero-bottom{position:relative;z-index:2}.hero .product{position:absolute;inset:45% 0 0;margin:0;overflow:visible;min-height:0}.hero .hero-keyboard{width:min(650px,60vw);position:relative}.hero .product-note{bottom:20px}.hero .section-line{position:absolute;bottom:10px;left:8vw;right:8vw;z-index:3}.hero .product-note,.hero .product-label{display:none}.intro-montage{position:absolute;inset:0;pointer-events:none;perspective:1200px}.montage-panel{position:absolute;width:270px;height:180px;background:#1e2c23;border:1px solid #506557;box-shadow:0 20px 50px #0008;padding:25px;display:flex;flex-direction:column;justify-content:space-between;left:calc(50% - 135px);top:calc(50% - 90px);backface-visibility:hidden;will-change:transform,opacity}.montage-panel span{font-size:9px;letter-spacing:2px;color:var(--mint)}.montage-panel strong{font:500 25px 'Space Grotesk',sans-serif}.montage-panel i{position:absolute;right:20px;bottom:15px;color:var(--mint);font-style:normal}.scroll-story{height:380vh}.features{height:260vh;padding:0;background:#0d100e;border:0;overflow:visible}.features-pin{position:sticky;top:0;height:100svh;min-height:650px;overflow:hidden;padding:40px 10vw;perspective:1500px}.features-pin>.eyebrow{font-size:9px}.features h2{position:absolute;top:27%;left:22%;width:56%;text-align:center;font-size:clamp(42px,6vw,95px);max-width:none;will-change:transform,opacity}.feature-grid{display:block;margin:0}.feature{position:absolute;background:#202922;border:1px solid #445548;width:270px;min-height:330px;padding:25px;box-shadow:0 20px 60px #0008;left:calc(50% - 135px);top:100%;opacity:1!important}.feature-visual{font-size:20px;height:90px;letter-spacing:2px}.feature h3{font-size:26px}.closing{position:relative;min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;isolation:isolate;background:#0c100e}.closing>*:not(.pixel-field){position:relative;z-index:1}.pixel-field{position:absolute;inset:0;z-index:-1;overflow:hidden;opacity:.55}.pixel-field span{position:absolute;bottom:-100%;left:var(--x);width:12%;height:var(--h);background:linear-gradient(0deg,#99d9ad99,#294a3533);will-change:transform}.closing h2{will-change:transform}.customize{position:relative;z-index:1;background:var(--bg)}
@media(max-width:1100px){.chapter-nav{display:none}}
@media(max-width:800px){.intro-scroll{height:210vh}.hero{min-height:750px;padding:30px 6vw 0}.hero h1{font-size:65px}.hero .product{inset:56% 0 6%}.hero .hero-keyboard{width:88vw}.hero-bottom .actions{gap:14px}.montage-panel{width:190px;height:135px;left:calc(50% - 95px);top:calc(50% - 67px);padding:17px}.montage-panel strong{font-size:19px}.montage-panel span{font-size:7px}.hero .section-line{left:6vw;right:6vw}.scroll-story{height:350vh}.features{height:270vh;padding:0}.features-pin{padding:30px 6vw}.features h2{left:8%;width:84%;top:20%;font-size:43px}.feature{width:230px;min-height:300px;left:calc(50% - 115px)}.feature-visual{height:75px}.feature h3{font-size:24px}.feature p{font-size:12px}}
@media(prefers-reduced-motion:reduce){.intro-scroll{height:auto}.hero{position:relative;min-height:900px}.hero h1{opacity:1!important}.intro-montage{display:none}.features{height:auto}.features-pin{position:static;height:auto;padding:80px 6vw}.features h2{position:static;width:auto;transform:none!important}.feature-grid{display:grid}.feature{position:static;transform:none!important;width:100%;min-height:0}.pixel-field{display:none}.chapter-nav{display:none}}
</style>

<style>.pixel-field{opacity:.65;background:radial-gradient(ellipse at 50% 130%,#5f9e6f88,transparent 70%)}.pixel-field span{bottom:-15%;width:10%;height:clamp(6px,1.6vh,18px);background:#7bb88b66}.closing .muted{color:#bac7bd}.closing .secondary{background:#101b14cc}</style>