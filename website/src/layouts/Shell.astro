---
const { title = 'Mousyst — Your mouse. Your keyboard.', lang = 'en', docs = false } = Astro.props;
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Meet Mousyst. Click letters, glide through words, and use keyboard shortcuts with your mouse. An offline Windows keyboard."/><title>{title}</title><link rel="icon" type="image/svg+xml" href="/logo.svg"/></head><body>
<header><a class="brand" href="/" aria-label="Mousyst home"><img src="/logo.svg" alt=""/>mousyst<span class="beta">DESKTOP PREVIEW</span></a><nav aria-label="Main navigation"><a href="/#how" data-en="The experience" data-zh="使用體驗">The experience</a><a href="/docs/" data-en="Documentation" data-zh="使用文件">Documentation</a><a href="https://github.com/HarvyLiu/Mousyst" target="_blank" rel="noreferrer">GitHub ↗</a><button id="language" aria-label="Switch language">繁體中文</button></nav></header>
<main><slot/></main><footer><a class="brand" href="/">mousyst</a><span data-en="Made for a different way to type." data-zh="用滑鼠，探索另一種輸入方式。">Made for a different way to type.</span><a href="/docs/" data-en="Read the docs ↗" data-zh="閱讀文件 ↗">Read the docs ↗</a></footer>
<script>
const stored = localStorage.getItem('mousyst-language');
function setLanguage(lang: string) { document.documentElement.lang = lang === 'zh' ? 'zh-Hant' : 'en'; document.querySelectorAll<HTMLElement>('[data-en]').forEach(el => { el.textContent = el.dataset[lang] || el.dataset.en || ''; }); const b = document.querySelector('#language'); if(b) b.textContent = lang === 'en' ? '繁體中文' : 'English'; localStorage.setItem('mousyst-language',lang); }
setLanguage(stored === 'zh' ? 'zh' : 'en');
document.querySelector('#language')?.addEventListener('click',()=>setLanguage(document.documentElement.lang === 'en' ? 'zh' : 'en'));
const observer = new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('revealed');observer.unobserve(entry.target)}}),{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
</script>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap');
:root{color-scheme:dark;--bg:#101211;--fg:#eeefe9;--muted:#939a94;--mint:#b7efcc;--line:#303632}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:100px}body{margin:0;background:var(--bg);color:var(--fg);font-family:'DM Sans','Noto Sans TC',sans-serif}body:before{content:'';position:fixed;inset:0;opacity:.035;pointer-events:none;z-index:20;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23fff' filter='url(%23n)' opacity='.7' d='M0 0h180v180H0z'/%3E%3C/svg%3E")}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}a:focus-visible,button:focus-visible{outline:2px solid var(--mint);outline-offset:5px}header{height:94px;display:flex;align-items:center;justify-content:space-between;padding:0 4vw;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:12px;font-family:'Space Grotesk',sans-serif;font-size:25px;font-weight:600;letter-spacing:-1px}.brand img{width:38px;height:38px}.beta{font:9px 'DM Sans',sans-serif;letter-spacing:1.5px;color:var(--muted);margin-left:12px}nav{display:flex;align-items:center;gap:30px;font-size:12px}nav a:hover,footer a:hover{color:var(--mint)}#language{border:1px solid var(--line);border-radius:30px;padding:9px 15px;background:transparent;color:var(--fg);font-size:12px}.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:2px;color:var(--mint);display:flex;align-items:center;gap:12px}.eyebrow:before{content:'';width:6px;height:6px;border-radius:50%;background:var(--mint)}h1,h2,h3{font-family:'Space Grotesk','Noto Sans TC',sans-serif;font-weight:500}h1{letter-spacing:-.075em;line-height:.99}h2{font-size:clamp(38px,5vw,72px);line-height:1.08;letter-spacing:-.05em;margin:24px 0}p{line-height:1.75}.muted{color:var(--muted)}.button{display:inline-flex;align-items:center;gap:25px;padding:15px 23px;background:var(--mint);color:#18251d;border:1px solid var(--mint);border-radius:4px;font-size:12px;font-weight:600}.button.secondary{background:transparent;color:var(--fg);border-color:#424a44}.button:hover{filter:brightness(1.1)}.reveal{opacity:0;transform:translateY(25px);transition:opacity .8s,transform .8s}.reveal.revealed{opacity:1;transform:none}footer{border-top:1px solid var(--line);margin:0 4vw;padding:35px 0;display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:12px}footer .brand{color:var(--fg)}@media(max-width:700px){header{height:76px;padding:0 22px}nav{gap:15px}nav>a:first-child,.beta{display:none}nav>a{font-size:10px}.brand{font-size:21px}.brand img{width:30px}footer{gap:22px;flex-wrap:wrap}.reveal{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
</style></body></html>
<style is:global>@media(max-width:700px){html[lang="zh-Hant"] .hero h1{font-size:40px;letter-spacing:-.04em;line-height:1.2}}</style>
